# ============================================================
# OfferForge 后端配置文件
# ============================================================
# 将此文件重命名为 .env 并填入真实值
# 注意：.env 文件包含敏感信息，不要提交到 Git！
# ============================================================

# ── MySQL 数据库 ───────────────────────────────────────────────
# 必须配置，用于存储用户、验证码等数据
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的MySQL密码
DB_NAME=offerforge

# ── JWT 密钥 ──────────────────────────────────────────────────
# 用于生成和校验登录 Token，请改为随机字符串（越长越安全）
# 生成随机字符串：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=offerforge_jwt_secret_请修改为随机字符串

# ── 前端地址 ──────────────────────────────────────────────────
# CORS 允许的前端地址，开发环境默认 localhost:5173
FRONTEND_URL=http://localhost:5173

# ── 阿里云短信（可选）─────────────────────────────────────────
# 不填：验证码会打印在终端控制台（开发模式）
# 填写：需先在阿里云控制台开通短信服务，获取 AccessKey
# 开通地址：https://ram.console.aliyun.com/manage/ak
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ── 邮件配置（可选，推荐用 QQ 邮箱）───────────────────────────
# QQ 邮箱配置步骤：
#   1. 登录 QQ 邮箱 → 设置 → 账户 → POP3/SMTP 服务 → 开启
#   2. 获取授权码（不是 QQ 密码！）
#   3. 将授权码填入 MAIL_PASS
# 163 邮箱：MAIL_HOST=smtp.163.com，其他同上
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=你的QQ邮箱@qq.com
MAIL_PASS=你的邮箱授权码
MAIL_FROM="OfferForge <你的QQ邮箱@qq.com>"

# ── 微信公众号（可选，需要已认证的服务号）─────────────────────
# 本地开发需配合 ngrok 做内网穿透：
#   ngrok http 3001
#   将 ngrok 生成的 https 地址配置到微信后台
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=

# ── 服务器端口 ────────────────────────────────────────────────
PORT=3001
